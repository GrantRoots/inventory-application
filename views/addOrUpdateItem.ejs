<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <h1>
      <%= formAction %><%formAction === 'add' ? ' to' : '' %> <%= category %>
    </h1>
    <form action="/<%= category %>/<%= formAction %>" method="post">
      <label for="name">
        Name
        <input
          type="text"
          name="name"
          required
          value="<%= values?.name || '' %>"
        />
      </label>
      <label for="price">
        Price
        <input
          type="number"
          step="0.01"
          min="0.01"
          max="9999.99"
          name="price"
          required
          value="<%= values?.price || '' %>"
        />
      </label>
      <label for="description">
        Description
        <input
          type="text"
          maxlength="255"
          name="description"
          required
          value="<%= values?.description || '' %>"
        />
      </label>
      <label for="quantity"
        >Quantity
        <input
          type="number"
          name="quantity"
          required
          value="<%= values?.quantity || '' %>"
        />
      </label>
      <button type="submit">Submit</button>
    </form>
  </body>
</html>
