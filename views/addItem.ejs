<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <h1>Adding To <%= category %></h1>
    <form action="/<%= category %>/add" method="post">
      <label for="name">
        Name
        <input type="text" name="name" required />
      </label>
      <label for="price">
        Price
        <input
          type="number"
          step="0.01"
          min="0.01"
          max="9999.99"
          name="price"
          required
        />
      </label>
      <label for="description">
        Description
        <input type="text" maxlength="255" name="description" required />
      </label>
      <label for="quantity"
        >Quantity
        <input type="number" name="quantity" required />
      </label>
      <button type="submit">Submit</button>
    </form>
  </body>
</html>
